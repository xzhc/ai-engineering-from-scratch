    "import numpy as np\n",
    "import random\n",
    "import timeit\n",
    "\n",
    "# 1. python list\n",
    "%timeit [random.random() for _ in range(1000000)]\n",
    "\n",
    "# 2. numpy array\n",
    "%timeit np.random.rand(1000000)\n",
    "\n",
    "# 3. pure python for loop\n",
    "%timeit random_numbers = [random.random() for _ in range(1000000)]"
   ]
